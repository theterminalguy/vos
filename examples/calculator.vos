// Simple calculator program

fn add(a: int, b: int) -> int {
    return a + b
}

fn subtract(a: int, b: int) -> int {
    return a - b
}

fn multiply(a: int, b: int) -> int {
    return a * b
}

fn divide(a: int, b: int) -> int {
    if b == 0 {
        print("Error: Division by zero")
        return 0
    }
    return a / b
}

fn main() -> int {
    print("=== VOS Calculator ===")

    let x = 20
    let y = 5

    print("Numbers:")
    print(x)
    print(y)

    print("Add:")
    print(add(x, y))

    print("Subtract:")
    print(subtract(x, y))

    print("Multiply:")
    print(multiply(x, y))

    print("Divide:")
    print(divide(x, y))

    return 0
}
