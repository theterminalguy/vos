// Fibonacci sequence calculator

fn fibonacci(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() -> int {
    let n = 10
    let result = fibonacci(n)
    print("Fibonacci of")
    print(n)
    print("is")
    print(result)
    return 0
}
