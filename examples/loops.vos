// Demonstrating loops and iteration

fn count_to_n(n: int) {
    print("Counting to")
    print(n)

    let i = 1
    while i <= n {
        print(i)
        i = i + 1
    }
}

fn sum_range(start: int, end: int) -> int {
    let sum = 0
    let i = start

    while i <= end {
        sum = sum + i
        i = i + 1
    }

    return sum
}

fn factorial_iterative(n: int) -> int {
    let result = 1
    let i = 2

    while i <= n {
        result = result * i
        i = i + 1
    }

    return result
}

fn main() -> int {
    print("=== Loop Examples ===")

    count_to_n(5)

    print("Sum from 1 to 10:")
    print(sum_range(1, 10))

    print("Factorial of 5:")
    print(factorial_iterative(5))

    return 0
}
